# Set this to the exact FNOS absolute path of the EXISTING config_lan folder.
# Example only: use the real path shown by FNOS File Manager on your NAS.
MIHOMO_CONFIG_DIR=/vol1/1000/docker/mihomo_lan/config_lan

# Must be byte-for-byte identical to `secret:` in config_lan/config.yaml.
# Leave empty only if config.yaml has no secret key.
MIHOMO_SECRET=

# Change only if 1224 is occupied.
MOPANEL_PORT=1224
